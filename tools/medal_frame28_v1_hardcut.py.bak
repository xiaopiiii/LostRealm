#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""28×28 圆形勋章底座 + 16×16 物品内嵌。边框保证 2 像素金属。

尺寸账（16×16 方形外接圆半径 11.31）：
  28 半径 13.5 → 环 2.19px  ← 能用
  24 半径 11.5 → 环 0.19px  ← 画不出边
  32 半径 15.5 → 环 4.19px  ← 物品只占 50%

关键：2.19px 里如果拿 1px 去画黑色描边，金属就只剩 1px，看着就细。
所以外缘那 1px 直接用「深色金属」而不是纯黑，把两格都留给金属。
"""
import math
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import pngtool

N = 28
C = (N - 1) / 2.0          # 13.5
R_OUT = 13.45
R_IN = 11.30               # 16×16 外接圆 11.31，刚好吃满不裁角

# 金属渐变：暗端 → 亮端，中间**不做分档**，每个像素按光照值直接插值。
# 之前按 12 档量化，环上相邻像素会跳 1~2 档（8~16% 的亮度突变），
# 沿圆周看就是一格一格的。改成连续插值后相邻差只有 2~3%，肉眼连成一条弧。
# 代价是色数变多（一枚环约 110 个像素 → 最多 110 色），
# 但这是贴图，不是调色板竞赛，柔和比"色数少"重要。
_DARK = (0x22, 0x21, 0x28)
_LIGHT = (0xe6, 0xe5, 0xec)
FACE = (0x24, 0x1e, 0x2e)
INNER = (0x16, 0x11, 0x1d)


def _rim(t):
    """t: 0(暗) ~ 1(亮)，返回连续插值后的金属色。"""
    t = max(0.0, min(1.0, t))
    return tuple(int(_DARK[i] + (_LIGHT[i] - _DARK[i]) * t) for i in range(3))


def base_frame():
    img = [[(0, 0, 0, 0)] * N for _ in range(N)]
    for y in range(N):
        for x in range(N):
            dx, dy = x - C, y - C
            r = math.hypot(dx, dy)
            if r > R_OUT:
                continue
            ang = math.atan2(dy, dx)
            lig = max(0.0, math.cos(ang + 0.75 * math.pi)) ** 0.55

            if r > R_IN:                        # 金属环：沿圆周连续渐变
                # 外圈比内圈暗 14%，做出"外沿压暗、内沿受光"的弧面感
                k = 0.86 if r > R_IN + 1.05 else 1.0
                col = _rim(lig * k)
            elif r > R_IN - 0.55:               # 内阴影
                col = INNER
            else:
                col = FACE if r < R_IN * 0.74 else INNER
            img[y][x] = col + (255,)
    return img


def embed(obj16):
    img = base_frame()
    ox = oy = (N - 16) // 2
    for y in range(16):
        for x in range(16):
            px = obj16[y][x]
            if px[3] > 8:
                img[oy + y][ox + x] = px
    for x in range(16):
        if obj16[15][x][3] > 8:
            img[oy + 16][ox + x] = INNER + (255,)
    return img


def sheet(tiles, k=12, pad=6, bg=(22, 24, 30, 255)):
    tw = N * k
    W = pad + len(tiles) * (tw + pad)
    H = tw + pad * 2
    canvas = [[bg] * W for _ in range(H)]
    x0 = pad
    for t in tiles:
        big = pngtool.scale(t, k)
        for y in range(tw):
            for i in range(tw):
                canvas[pad + y][x0 + i] = big[y][i]
        x0 += tw + pad
    return canvas


if __name__ == '__main__':
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    TEX = os.path.join(root, 'src/main/resources/assets/lost_realm/textures/item')
    SRC = os.environ.get('MEDAL_SRC') or os.path.join(root, '..', '..', 'tmp_cc0', 'content16')
    out = []
    for c in ('archer', 'blade', 'tank', 'mage', 'summoner'):
        obj = pngtool.read_png(os.path.join(SRC, f'{c}.png'))
        assert len(obj) == 16 and len(obj[0]) == 16, (c, len(obj[0]), len(obj))
        framed = embed(obj)
        out.append(framed)
        pngtool.write_png(os.path.join(TEX, f'{c}_medal.png'), framed)
        print(f'{c:9s} 28×28 色数={pngtool.palette_size(framed)}')
    pngtool.write_png(os.path.join(root, '..', '..', 'tmp_cc0', 'framed28b.png'), sheet(out))
    print('预览 -> tmp_cc0/framed28b.png')
